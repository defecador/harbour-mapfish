set(PLATFORM_LINUX FALSE)
set(PLATFORM_MAC FALSE)
set(PLATFORM_WIN FALSE)
set(PLATFORM_ANDROID FALSE)
set(PLATFORM_IPHONE FALSE)
set(PLATFORM_DESKTOP FALSE)
set(PLATFORM_SAILFISH FALSE)

option(BUILD_SAILFISH "Build the Sailfish OS app instead of the desktop one" OFF)

if ("${CMAKE_SYSTEM_NAME}" STREQUAL "Linux")
  set(PLATFORM_LINUX TRUE)
  if (BUILD_SAILFISH)
    set(PLATFORM_SAILFISH TRUE)
    add_compile_definitions(OMIM_OS_SAILFISH)
    # On 32-bit Sailfish targets (armv7hl), off_t defaults to 32 bits; this is glibc's standard
    # way to make it 64-bit instead, which libs/coding/internal/file64_api.hpp requires. A no-op
    # on 64-bit targets, where off_t is already 64-bit.
    add_compile_definitions(_FILE_OFFSET_BITS=64)
  else()
    set(PLATFORM_DESKTOP TRUE)
  endif()
elseif ("${CMAKE_SYSTEM_NAME}" STREQUAL "Darwin")
  set(PLATFORM_MAC TRUE)
  set(PLATFORM_DESKTOP TRUE)
elseif ("${CMAKE_SYSTEM_NAME}" STREQUAL "Windows")
  set(PLATFORM_WIN TRUE)
  set(PLATFORM_DESKTOP TRUE)
elseif ("${CMAKE_SYSTEM_NAME}" STREQUAL "Android")
  set(PLATFORM_ANDROID TRUE)
elseif ("${CMAKE_SYSTEM_NAME}" STREQUAL "iOS")
  set(PLATFORM_IPHONE TRUE)
else ()
  message(FATAL_ERROR "Unsupported platform: ${CMAKE_SYSTEM_NAME}")
endif ()
